<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pds.logistics.ui.controllers.InventoryController" spacing="0">
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="🏭 Inventory" styleClass="page-title"/>
            <Label text="Grain stock at depots and warehouses" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻ Refresh" styleClass="btn-secondary" onAction="#loadData"/>
    </HBox>
    <TableView fx:id="tblInventory" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"        text="ID"          prefWidth="60"/>
            <TableColumn fx:id="colLocation"  text="Location"    prefWidth="200"/>
            <TableColumn fx:id="colGrain"     text="Grain"       prefWidth="100"/>
            <TableColumn fx:id="colQuantity"  text="Stock (MT)"  prefWidth="110"/>
            <TableColumn fx:id="colAllocated" text="Allocated"   prefWidth="110"/>
            <TableColumn fx:id="colAvailable" text="Available"   prefWidth="110"/>
            <TableColumn fx:id="colDate"      text="Report Date" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>
