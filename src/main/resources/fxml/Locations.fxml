<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pds.logistics.ui.controllers.LocationsController"
      spacing="0">

    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="📍 Locations" styleClass="page-title"/>
            <Label text="Manage depots, warehouses, and fair price shops" styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.65">

        <!-- Table -->
        <VBox spacing="12" style="-fx-padding: 16px;">
            <Label text="All Locations" styleClass="panel-title"/>
            <TableView fx:id="tblLocations" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"       prefWidth="50"/>
                    <TableColumn fx:id="colCode"     text="Code"     prefWidth="110"/>
                    <TableColumn fx:id="colName"     text="Name"     prefWidth="200"/>
                    <TableColumn fx:id="colType"     text="Type"     prefWidth="140"/>
                    <TableColumn fx:id="colDistrict" text="District" prefWidth="100"/>
                    <TableColumn fx:id="colState"    text="State"    prefWidth="90"/>
                    <TableColumn fx:id="colActive"   text="Active"   prefWidth="60"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Form -->
        <VBox styleClass="panel" spacing="12" style="-fx-padding: 16px;">
            <Label text="Add / Edit Location" styleClass="panel-title"/>
            <Separator/>

            <Label text="Code *" style="-fx-text-fill: #8b949e;"/>
            <TextField fx:id="txfCode" promptText="e.g. FCI-MH-04"/>

            <Label text="Name *" style="-fx-text-fill: #8b949e;"/>
            <TextField fx:id="txfName" promptText="Full name"/>

            <Label text="Type *" style="-fx-text-fill: #8b949e;"/>
            <ComboBox fx:id="cmbType" maxWidth="Infinity"/>

            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="District" style="-fx-text-fill: #8b949e;"/>
                    <TextField fx:id="txfDistrict" promptText="District"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="State" style="-fx-text-fill: #8b949e;"/>
                    <TextField fx:id="txfState" promptText="State" text="Maharashtra"/>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Latitude" style="-fx-text-fill: #8b949e;"/>
                    <TextField fx:id="txfLat" promptText="e.g. 18.52"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Longitude" style="-fx-text-fill: #8b949e;"/>
                    <TextField fx:id="txfLon" promptText="e.g. 73.85"/>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Canvas X (0-1)" style="-fx-text-fill: #8b949e;"/>
                    <TextField fx:id="txfCx" promptText="e.g. 0.5"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Canvas Y (0-1)" style="-fx-text-fill: #8b949e;"/>
                    <TextField fx:id="txfCy" promptText="e.g. 0.5"/>
                </VBox>
            </HBox>

            <CheckBox fx:id="chkActive" text="Active" textFill="#e6edf3" selected="true"/>

            <Label fx:id="lblFormStatus" text="" style="-fx-text-fill: #8b949e; -fx-font-size:11px;"/>
            <Separator/>

            <HBox spacing="10">
                <Button text="💾 Save"   styleClass="btn-primary"   onAction="#saveLocation"   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="🗑 Delete" styleClass="btn-danger"    onAction="#deleteLocation"/>
                <Button text="✖ Clear"  styleClass="btn-secondary" onAction="#clearForm"/>
            </HBox>
        </VBox>
    </SplitPane>
</VBox>
